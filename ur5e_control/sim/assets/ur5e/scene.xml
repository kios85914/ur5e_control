<mujoco model="ur5e_scene">
  <!-- UR5e (official mujoco_menagerie model: accurate kinematics/inertia/meshes).
       meshdir="assets" inside ur5e.xml resolves relative to this directory. -->
  <include file="ur5e.xml"/>

  <statistic center="0.3 0 0.4" extent="1.2"/>
  <visual>
    <global azimuth="120" elevation="-20"/>
    <quality shadowsize="4096"/>
  </visual>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="3 3 0.05" rgba="0.25 0.26 0.30 1"/>

    <!-- A rigid table/box to push onto, for guarded_move / force tests. Centred
         under the home TCP (world ~[-0.13, 0.49, 0.49]); top surface at z=0.40 so
         moving straight down from home reaches contact in ~9 cm. -->
    <body name="table" pos="-0.13 0.49 0.38">
      <geom name="table_top" type="box" size="0.40 0.40 0.02"
            rgba="0.55 0.38 0.22 1" friction="1 0.05 0.001"/>
    </body>
  </worldbody>

  <!-- Wrist force/torque sensor at the tool flange (attachment_site). Reads the
       interaction force transmitted through the flange -- i.e. the contact
       reaction when the tool touches the table -- mimicking the Robotiq FT. -->
  <sensor>
    <force name="ft_force" site="attachment_site"/>
    <torque name="ft_torque" site="attachment_site"/>
  </sensor>
</mujoco>
